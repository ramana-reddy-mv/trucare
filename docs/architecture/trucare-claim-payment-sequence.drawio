="geometry" /></mxCell><mxCell id="msg13" edge="1" parent="1" source="a13" target="b13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" value="13. Calculate payable; persist settlement + audit / breakdown"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a14" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1435" y="860" width="2" height="2" as="geometry" /></mxCell><mxCell id="b14" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1625" y="860" width="2" height="2" as="geometry" /></mxCell><mxCell id="msg14" edge="1" parent="1" source="a14" target="b14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" value="14. Payment requests settlement details"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a15" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1625" y="910" width="2" height="2" as="geometry" /></mxCell><mxCell id="b15" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1435" y="910" width="2" height="2" as="geometry" /></mxCell><mxCell id="msg15" edge="1" parent="1" source="a15" target="b15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" value="15. READY_FOR_PAYMENT + authoritative amount / recipient"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a16" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1625" y="960" width="2" height="2" as="geometry" /></mxCell><mxCell id="b16" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1815" y="960" width="2" height="2" as="geometry" /></mxCell><mxCell id="msg16" edge="1" parent="1" source="a16" target="b16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" value="16. Execute gateway via MOCK PaymentGateway"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a17" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1815" y="1010" width="2" height="2" as="geometry" /></mxCell><mxCell id="b17" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1625" y="1010" width="2" height="2" as="geometry" /></mxCell><mxCell id="msg17" edge="1" parent="1" source="a17" target="b17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" value="17. Payment result; persist tx / audit / callback"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a18" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1625" y="1060" width="2" height="2" as="geometry" /></mxCell><mxCell id="b18" vertex="1" parent="1" style="ellipse;opacity=0;fillOpacity=0;strokeOpacity=0;"><mxGeometry x="1435" y="1060" width="2" height="2" as="geometry" /></mxCell><mxCell id="msg18" edge="1" parent="1" source="a18" target="b18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" value="18. Callback updates settlement payment status"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" vertex="1" parent="1" value="Failure / safeguards: claim idempotency key + SHA-256 request hash (same key/same payload replays; changed payload returns conflict); policy/member/provider validation uses Feign + retry/circuit breaker. Settlement has unique claimId + idempotency key and version/locking. Payment has unique settlementId + idempotency key and validates READY_FOR_PAYMENT before processing. Callback delivery has durable retry records. Payment Gateway is currently MOCK by configuration. Notification service has its own delivery worker but no producer connection is represented as live here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#94a3b8;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=7;fontStyle=0;dashed=1;"><mxGeometry x="100" y="1120" width="1800" height="115" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>