al)&lt;br&gt;• Provider 1 → many Claims (logical)&lt;br&gt;• Member 1 → many Care records (logical)&lt;br&gt;• Provider 1 → many Care records (logical)&lt;br&gt;• Member ↔ Document via join table (recommended)&lt;br&gt;• Claim ↔ Document via join table (recommended)&lt;br&gt;&lt;br&gt;&lt;i&gt;Cross-service IDs are logical references, not enforced cross-database FKs.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="180" width="340" height="330" as="geometry" /></mxCell><mxCell id="r1" value="1 : N • memberId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="Member" target="Claim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r2" value="1 : N • providerId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="Provider" target="Claim"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r3" value="1 : N • memberId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="Member" target="Care"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r4" value="1 : N • careProviderId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="Provider" target="Care"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="Member" target="MemberDocument"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;