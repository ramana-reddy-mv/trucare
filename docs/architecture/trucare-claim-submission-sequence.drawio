idth=1;" vertex="1" parent="1"><mxGeometry x="1590" y="150" width="1" height="950" as="geometry" /></mxCell><mxCell id="act-ui" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=70;" vertex="1" parent="1"><mxGeometry x="325" y="205" width="10" height="780" as="geometry" /></mxCell><mxCell id="act-gw" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=70;" vertex="1" parent="1"><mxGeometry x="565" y="245" width="10" height="690" as="geometry" /></mxCell><mxCell id="act-cs" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=70;" vertex="1" parent="1"><mxGeometry x="815" y="285" width="10" height="610" as="geometry" /></mxCell><mxCell id="act-ms" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=70;" vertex="1" parent="1"><mxGeometry x="1075" y="390" width="10" height="95" as="geometry" /></mxCell><mxCell id="act-ps" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=70;" vertex="1" parent="1"><mxGeometry x="1335" y="510" width="10" height="95" as="geometry" /></mxCell><mxCell id="act-db" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=70;" vertex="1" parent="1"><mxGeometry x="1585" y="650" width="10" height="90" as="geometry" /></mxCell><mxCell id="m1" value="1. Submit claim details" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="205" as="sourcePoint" /><mxPoint x="330" y="205" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m2" value="2. POST /api/claims" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="245" as="sourcePoint" /><mxPoint x="570" y="245" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m3" value="3. Route request + forward JWT" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="285" as="sourcePoint" /><mxPoint x="820" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m4" value="4. Validate request fields" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="330" as="sourcePoint" /><mxPoint x="820" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m5" value="5. GET /members/{memberId}" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="390" as="sourcePoint" /><mxPoint x="1080" y="390" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m6" value="6. Member details / not found" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="435" as="sourcePoint" /><mxPoint x="820" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m7" value="7. GET /providers/{providerId}" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="510" as="sourcePoint" /><mxPoint x="1340" y="510" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m8" value="8. Provider details + status" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="555" as="sourcePoint" /><mxPoint x="820" y="555" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m9" value="9. Save claim (generated claimId)" style="edgeStyle=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="650" as="sourcePoint" /><mxPoint x="1590" y="650" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m10" value="10. Persist claim record" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="695" as="sourcePoint" /><mxPoint x="1590" y="695" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m11" value="11. Saved Claim response" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="740" as="sourcePoint" /><mxPoint x="820" y="740" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m12" value="12. 201 Created + claim response" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="790" as="sourcePoint" /><mxPoint x="570" y="790" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m13" value="13. HTTP response" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="835" as="sourcePoint" /><mxPoint x="330" y="835" as="targetPoint" /></mxGeometry></mxCell><mxCell id="m14" value="14. Show claim confirmation" style="edgeStyle=none;html=1;rounded=0;strokeColor=#666666;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="880" as="sourcePoint" /><mxPoint x="100" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="alt1" value="&lt;b&gt;Alternative flows&lt;/b&gt;&lt;br&gt;&lt;b&gt;[Member does not exist]&lt;/b&gt; Claim Service stops processing and returns a member validation error (e.g. 404).&lt;br&gt;&lt;b&gt;[Provider does not exist / inactive]&lt;/b&gt; Claim Service rejects the request; no claim is persisted.&lt;br&gt;&lt;b&gt;[Invalid request]&lt;/b&gt; Return 400 with validation details before downstream calls." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;dashPattern=6 4;fontSize=12;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="350" y="930" width="900" height="125" as="geometry" /></mxCell><mxCell id="note1" value="&lt;b&gt;Implementation notes&lt;/b&gt;&lt;br&gt;• Member and Provider lookups are shown as Feign/REST calls from Claim Service.&lt;br&gt;• Claim ID is generated by the Claim Service before persistence (confirm exact strategy in code).&lt;br&gt;• documentIds are stored on the claim model; this diagram does not assume a Document Service validation call because that flow has not been confirmed.&lt;br&gt;• Cross-service memberId/providerId are logical references, not necessarily database foreign keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="350" y="1070" width="900" height="120" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;  Solid arrow = request / call     Dashed arrow = response     Narrow vertical bar = active execution" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="1210" width="700" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>